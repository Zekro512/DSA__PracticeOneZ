Books Table
CREATE TABLE Books(

BookID INT,

BookName VARCHAR(100),

Price DECIMAL(10,2)

);
INSERT

Add books.

INSERT INTO Books

VALUES

(101,'DBMS',499.99);

Insert another.

INSERT INTO Books

VALUES

(102,'Java',599.99);

Table becomes:

BookID	BookName	Price
101	DBMS	499.99
102	Java	599.99
SELECT

Read data.

SELECT * FROM Books;

Output:

BookID	BookName	Price
101	DBMS	499.99
102	Java	599.99
UPDATE

Book goes on sale.

UPDATE Books

SET Price=399.99

WHERE BookID=101;

Now:

BookID	BookName	Price
101	DBMS	399.99
DELETE

Book discontinued.

DELETE FROM Books

WHERE BookID=102;

Java disappears.

